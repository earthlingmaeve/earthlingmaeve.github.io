---
const projects = [
  {
    title: "Active Directory IAM Lab",
    description:
      "A fictional enterprise environment built to practice users, groups, OUs, Group Policy, permissions, and identity lifecycle management.",
    status: "In progress",
  },
  {
    title: "Identity Automation",
    description:
      "PowerShell automation for provisioning, modifying, disabling, and auditing identity accounts.",
    status: "Planned",
  },
  {
    title: "Hybrid Identity Lab",
    description:
      "A future hybrid environment connecting on-premises Active Directory with Microsoft Entra ID.",
    status: "Planned",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Earthlingmaeve — IAM, cloud, automation, and homelab projects." />
    <title>Earthlingmaeve | IAM & Cloud Homelab</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="logo">earthlingmaeve</a>

        <div class="nav-links">
          <a href="#projects">Projects</a>
          <a href="#blog">Blog</a>
          <a href="#about">About</a>
          <a href="https://github.com/earthlingmaeve">GitHub</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">HELPDESK → IAM / CLOUD</p>

        <h1>Building my way into identity and cloud engineering.</h1>

        <p class="intro">
          I'm learning by building. This site documents my homelab,
          identity projects, automation experiments, and the things I
          break along the way.
        </p>

        <div class="actions">
          <a href="#projects" class="button">View projects</a>
          <a href="https://github.com/earthlingmaeve" class="button secondary">
            GitHub
          </a>
        </div>
      </section>

      <section id="projects">
        <p class="eyebrow">PROJECTS</p>
        <h2>Things I'm building</h2>

        <div class="project-grid">
          {
            projects.map((project) => (
              <article class="project">
                <span class="status">{project.status}</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="blog">
        <p class="eyebrow">BLOG</p>
        <h2>Learning in public</h2>

        <p>
          I'll use this space to document homelab builds, IAM concepts,
          troubleshooting, PowerShell automation, and cloud experiments.
        </p>

        <p>
          <strong>First posts coming soon.</strong>
        </p>
      </section>

      <section id="about">
        <p class="eyebrow">ABOUT</p>
        <h2>Why this exists</h2>

        <p>
          I'm building practical experience in identity and cloud
          engineering through a hands-on homelab. Rather than collecting
          tutorials, I'm trying to build systems, troubleshoot them,
          document what I learn, and turn the results into portfolio
          projects.
        </p>
      </section>
    </main>

    <footer>
      <p>Built with Astro · Documented on GitHub</p>
    </footer>
  </body>
</html>

